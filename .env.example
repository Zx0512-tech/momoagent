# 智能体的意图识别、参数抽取和多轮澄清依赖兼容 OpenAI 接口的大模型。
MOMO_LLM_BASE_URL=https://your-compatible-api.example/v1
MOMO_LLM_MODEL=your-model-name
MOMO_LLM_API_KEY=replace-with-your-api-key
MOMO_LLM_TIMEOUT_S=120
# Harness 默认启用模型内部思考；思考内容不向前端展示，只输出工具调用、结论和证据。
MOMO_LLM_HARNESS_THINKING=true
MOMO_LLM_HARNESS_MAX_TOKENS=4096
# 默认使用流程驱动 Tool Harness；遇到迁移问题时可临时切回 LEGACY。
MOMO_AGENT_RUNTIME=WORKFLOW_HARNESS
MOMO_AGENT_PERSISTENT_LOOP=true
# 平台独立工程入口的生产门禁；MOCK 仅用于本地演示，真实部署请显式设为 LIVE。
MOMO_PLATFORM_MODE=LIVE
# ANSYS USER300 的 UserElemLib.dll 所在目录；本机路径只写入被 Git 忽略的 .env。
MOMO_ANSYS_USER_ELEMENT_PATH=ansys\build_userelem
