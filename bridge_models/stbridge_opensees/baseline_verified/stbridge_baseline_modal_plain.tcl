        if {$absZ > $maxAbsZ} { set maxAbsZ $absZ; set maxZNode $node; set maxUz $uz }
    }
    puts [format "mode_direction %d X=%.4e Y=%.4e Z=%.4e" $mode $sx $sy $sz]
