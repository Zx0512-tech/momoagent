# Windows 双击启动器必须保持原生 CRLF，避免旧版命令解释器误解析。
/momo.cmd text eol=crlf
/start.ps1 text eol=crlf

# 地震记录夹具是逐字节原样保存的外部数据（PEER NGA）。autocrlf 会在检出时
# 改写行尾，夹具就不再与原始记录逐字节一致，按裸字节登记的 SHA 也会漂移。
/momo_agent/backend/tests/fixtures/earthquake/*.AT1 -text
/momo_agent/backend/tests/fixtures/earthquake/*.AT2 -text

# 风荷载生成脚本与其产出的逐节点记录：提交清单按磁盘裸字节校验 SHA。
/analysis_data/wind_inputs/generate_wind_nodal_force.py text eol=lf
/analysis_data/wind_inputs/wind_vertical_*nodes_*.csv text eol=lf

# 标定件的 SHA256 按 LF 字节登记；校验器按磁盘裸字节核验。
/docs/examples/templates/calibration/** text eol=lf
