+/* ****************************************************************** **
+**    OpenSees - Open System for Earthquake Engineering Simulation    **
+** ****************************************************************** */
+
+#include <User300DamperMaterial.h>
+
+#include <Channel.h>
+#include <Information.h>
+#include <OPS_Globals.h>
+#include <Parameter.h>
+#include <Vector.h>
+#include <classTags.h>
+#include <elementAPI.h>
+
