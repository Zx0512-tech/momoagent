+namespace {
+
+void *createUser300Material(User300DamperMaterial::DamperKind kind,
+                            int classTag, const char *name)
+{
+  int numArgs = OPS_GetNumRemainingInputArgs();
+  int requiredArgs = kind == User300DamperMaterial::Viscous ? 4 : 3;
+  if (numArgs != requiredArgs) {
+    if (kind == User300DamperMaterial::Viscous) {
+      opserr << "Invalid #args, want: uniaxialMaterial " << name
+             << " tag? C? alpha? vFloor?" << endln;
+    } else if (kind == User300DamperMaterial::EddyCurrent) {
+      opserr << "Invalid #args, want: uniaxialMaterial " << name
+             << " tag? Fmax? Vcr?" << endln;
+    } else {
+      opserr << "Invalid #args, want: uniaxialMaterial " << name
+             << " tag? Fc? Vs?" << endln;
+    }
+    return 0;
+  }
+
+  int tag = 0;
+  int numData = 1;
+  if (OPS_GetIntInput(&numData, &tag) != 0) {
+    opserr << "WARNING invalid tag for uniaxialMaterial " << name << endln;
+    return 0;
+  }
+
+  double data[3] = {0.0, 0.0, 0.0};
+  numData = requiredArgs - 1;
+  if (OPS_GetDoubleInput(&numData, data) != 0) {
+    opserr << "WARNING invalid data for uniaxialMaterial " << name
+           << " tag " << tag << endln;
+    return 0;
+  }
+
+  return new User300DamperMaterial(tag, classTag, kind, data[0], data[1],
+                                   data[2]);
+}
+
+const char *kindName(User300DamperMaterial::DamperKind kind)
+{
+  switch (kind) {
+  case User300DamperMaterial::Viscous:
+    return "User300Viscous";
+  case User300DamperMaterial::EddyCurrent:
+    return "User300EddyCurrent";
+  case User300DamperMaterial::Friction:
+    return "User300Friction";
+  default:
+    return "User300DamperMaterial";
+  }
+}
+
+} // namespace
+
+void *OPS_User300ViscousMaterial(void)
+{
+  return createUser300Material(User300DamperMaterial::Viscous,
+                               MAT_TAG_User300Viscous,
+                               "User300Viscous");
+}
+
+void *OPS_User300EddyCurrentMaterial(void)
+{
+  return createUser300Material(User300DamperMaterial::EddyCurrent,
+                               MAT_TAG_User300EddyCurrent,
+                               "User300EddyCurrent");
+}
+
+void *OPS_User300FrictionMaterial(void)
+{
+  return createUser300Material(User300DamperMaterial::Friction,
+                               MAT_TAG_User300Friction,
+                               "User300Friction");
+}
+
+User300DamperMaterial::User300DamperMaterial(int tag, int classTag,
+                                             DamperKind kind, double p1,
+                                             double p2, double p3)
+  : UniaxialMaterial(tag, classTag),
+    materialKind(kind),
+    materialClassTag(classTag),
+    param1(p1),
+    param2(p2),
+    param3(p3),
+    trialStrain(0.0),
+    trialRate(0.0),
+    commitStrain(0.0),
+    commitRate(0.0)
+{
+  sanitizeParameters();
+}
+
+User300DamperMaterial::User300DamperMaterial()
+  : UniaxialMaterial(0, MAT_TAG_User300Viscous),
+    materialKind(Viscous),
+    materialClassTag(MAT_TAG_User300Viscous),
+    param1(0.0),
+    param2(1.0),
+    param3(1.0e-5),
+    trialStrain(0.0),
+    trialRate(0.0),
+    commitStrain(0.0),
+    commitRate(0.0)
+{
+}
+
+User300DamperMaterial::~User300DamperMaterial()
+{
+}
+
+const char *User300DamperMaterial::getClassType(void) const
+{
+  return kindName(materialKind);
+}
+
+int User300DamperMaterial::setTrialStrain(double strain, double strainRate)
+{
+  trialStrain = strain;
+  trialRate = strainRate;
+  return 0;
+}
+
+double User300DamperMaterial::getStrain(void)
+{
+  return trialStrain;
+}
+
+double User300DamperMaterial::getStrainRate(void)
+{
+  return trialRate;
+}
+
+double User300DamperMaterial::getStress(void)
+{
+  return force(trialRate);
+}
+
+double User300DamperMaterial::getTangent(void)
+{
+  return 0.0;
+}
+
+double User300DamperMaterial::getInitialTangent(void)
+{
+  return 0.0;
+}
+
+double User300DamperMaterial::getDampTangent(void)
+{
+  return dampTangent(trialRate);
+}
+
+int User300DamperMaterial::commitState(void)
+{
+  commitStrain = trialStrain;
+  commitRate = trialRate;
+  return 0;
+}
+
+int User300DamperMaterial::revertToLastCommit(void)
+{
+  trialStrain = commitStrain;
+  trialRate = commitRate;
+  return 0;
+}
+
+int User300DamperMaterial::revertToStart(void)
+{
+  trialStrain = 0.0;
+  trialRate = 0.0;
+  commitStrain = 0.0;
+  commitRate = 0.0;
+  return 0;
+}
+
+UniaxialMaterial *User300DamperMaterial::getCopy(void)
+{
+  User300DamperMaterial *copy = new User300DamperMaterial(
+      this->getTag(), materialClassTag, materialKind, param1, param2, param3);
+  copy->trialStrain = trialStrain;
+  copy->trialRate = trialRate;
+  copy->commitStrain = commitStrain;
+  copy->commitRate = commitRate;
+  return copy;
+}
+
+int User300DamperMaterial::sendSelf(int cTag, Channel &theChannel)
+{
+  static Vector data(9);
+  data(0) = this->getTag();
+  data(1) = materialClassTag;
+  data(2) = static_cast<int>(materialKind);
+  data(3) = param1;
+  data(4) = param2;
+  data(5) = param3;
+  data(6) = trialStrain;
+  data(7) = trialRate;
+  data(8) = commitRate;
+  return theChannel.sendVector(this->getDbTag(), cTag, data);
+}
+
+int User300DamperMaterial::recvSelf(int cTag, Channel &theChannel,
+                                    FEM_ObjectBroker &theBroker)
+{
+  static Vector data(9);
+  int res = theChannel.recvVector(this->getDbTag(), cTag, data);
+  if (res < 0) {
+    opserr << "User300DamperMaterial::recvSelf() - failed to receive data\n";
+    return res;
+  }
+  this->setTag(static_cast<int>(data(0)));
+  materialClassTag = static_cast<int>(data(1));
+  materialKind = static_cast<DamperKind>(static_cast<int>(data(2)));
+  param1 = data(3);
+  param2 = data(4);
+  param3 = data(5);
+  trialStrain = data(6);
+  trialRate = data(7);
+  commitStrain = trialStrain;
+  commitRate = data(8);
+  sanitizeParameters();
+  return 0;
+}
+
+void User300DamperMaterial::Print(OPS_Stream &s, int flag)
+{
+  s << kindName(materialKind) << " tag: " << this->getTag() << endln;
+  if (materialKind == Viscous) {
+    s << "  C: " << param1 << endln;
+    s << "  alpha: " << param2 << endln;
+    s << "  vFloor: " << param3 << endln;
+  } else if (materialKind == EddyCurrent) {
+    s << "  Fmax: " << param1 << endln;
+    s << "  Vcr: " << param2 << endln;
+  } else {
+    s << "  Fc: " << param1 << endln;
+    s << "  Vs: " << param2 << endln;
+  }
+}
+
+int User300DamperMaterial::setParameter(const char **argv, int argc,
+                                        Parameter &param)
+{
+  if (argc < 1) {
+    return -1;
+  }
+  if (strcmp(argv[0], "C") == 0 || strcmp(argv[0], "Fmax") == 0 ||
+      strcmp(argv[0], "Fc") == 0 || strcmp(argv[0], "p1") == 0) {
+    param.setValue(param1);
+    return param.addObject(1, this);
+  }
+  if (strcmp(argv[0], "alpha") == 0 || strcmp(argv[0], "Vcr") == 0 ||
+      strcmp(argv[0], "Vs") == 0 || strcmp(argv[0], "p2") == 0) {
+    param.setValue(param2);
+    return param.addObject(2, this);
+  }
+  if (strcmp(argv[0], "vFloor") == 0 || strcmp(argv[0], "p3") == 0) {
+    param.setValue(param3);
+    return param.addObject(3, this);
+  }
+  return -1;
+}
+
+int User300DamperMaterial::updateParameter(int parameterID, Information &info)
+{
+  if (parameterID == 1) {
+    param1 = info.theDouble;
+  } else if (parameterID == 2) {
+    param2 = info.theDouble;
+  } else if (parameterID == 3) {
+    param3 = info.theDouble;
+  } else {
+    return -1;
+  }
+  sanitizeParameters();
+  return 0;
+}
+
+double User300DamperMaterial::force(double velocity) const
+{
+  const double v = velocity;
+  const double absV = std::fabs(v);
+  if (materialKind == Viscous) {
+    // 与 ANSYS USER300 黏滞分支一致：F=C*max(|v|,VFLOOR)^(alpha-1)*v。
+    return param1 * std::pow(absV > param3 ? absV : param3, param2 - 1.0) * v;
+  }
+  if (materialKind == EddyCurrent) {
+    // 与 ANSYS USER300 电涡流分支一致。
+    return 2.0 * param1 * param2 * v / (v * v + param2 * param2);
+  }
+  // 与 ANSYS USER300 摩擦分支一致。
+  return param1 * std::tanh(v / param2);
+}
+
+double User300DamperMaterial::dampTangent(double velocity) const
+{
+  const double v = velocity;
+  const double absV = std::fabs(v);
+  if (materialKind == Viscous) {
+    if (absV < param3) {
+      return param1 * std::pow(param3, param2 - 1.0);
+    }
+    return param1 * param2 * std::pow(absV, param2 - 1.0);
+  }
+  if (materialKind == EddyCurrent) {
+    const double den = v * v + param2 * param2;
+    return 2.0 * param1 * param2 * (param2 * param2 - v * v) /
+           (den * den);
+  }
+  const double tanhValue = std::tanh(v / param2);
+  return param1 / param2 * (1.0 - tanhValue * tanhValue);
+}
+
+void User300DamperMaterial::sanitizeParameters(void)
+{
+  if (materialKind != Viscous && materialKind != EddyCurrent &&
+      materialKind != Friction) {
+    materialKind = Viscous;
+  }
+  if (materialClassTag == 0) {
+    materialClassTag = MAT_TAG_User300Viscous;
+  }
+  if (param1 <= 0.0) {
+    opserr << kindName(materialKind)
+           << "::sanitizeParameters -- first parameter <= 0, using 1.0\n";
+    param1 = 1.0;
+  }
+  if (param2 <= 0.0) {
+    opserr << kindName(materialKind)
+           << "::sanitizeParameters -- second parameter <= 0, using 1.0\n";
+    param2 = 1.0;
+  }
+  if (materialKind == Viscous && param3 <= 0.0) {
+    opserr << "User300Viscous::sanitizeParameters -- vFloor <= 0, using 1.0e-12\n";
+    param3 = 1.0e-12;
+  }
+}
